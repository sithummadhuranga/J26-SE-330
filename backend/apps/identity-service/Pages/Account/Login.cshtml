@page "/account/login"
@model IdentityService.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p class="sub">@Model.ClientName · Clinical wound assessment support</p>

@if (Model.ErrorMessage is not null)
{
    <p class="error" role="alert" data-code="@Model.ErrorCode">@Model.ErrorMessage</p>
}

<form method="post" autocomplete="off">
    <input type="hidden" asp-for="ReturnUrl" />
    @if (Model.AskForNewPassword)
    {
        <input type="hidden" asp-for="ChangeTicket" />
        <p>Your admin set this password for you. Choose your own before you continue.</p>
        <label for="NewPassword">New password</label>
        <input asp-for="NewPassword" id="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" autofocus required />
        <label for="ConfirmPassword">New password again</label>
        <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
        <button type="submit">Change password and continue</button>
    }
    else if (Model.AskForTotp)
    {
        <input type="hidden" asp-for="MfaTicket" />
        <label for="Totp">Authenticator code</label>
        <input asp-for="Totp" id="Totp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" autofocus required />
        <button type="submit">Verify</button>
    }
    else
    {
        <label for="Username">Username</label>
        <input asp-for="Username" id="Username" autocomplete="username" autocapitalize="none" autofocus required />
        <label for="Password">Password</label>
        <input asp-for="Password" id="Password" type="password" autocomplete="current-password" required />
        <button type="submit">Sign in</button>
    }
</form>
