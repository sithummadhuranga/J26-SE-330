@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p class="sub">@Model.ClientName · Clinical wound assessment support</p>

@if (Model.ErrorMessage is not null)
{
    <p class="error" role="alert" data-code="@Model.ErrorCode">@Model.ErrorMessage</p>
}

@* No action, so returnUrl stays in the query string instead of a form field. *@
<form method="post" autocomplete="off">
    @if (Model.AskForNewPassword)
    {
        <input type="hidden" name="ChangeTicket" value="@Model.ChangeTicket" />
        <p>Your admin set this password for you. Choose your own before you continue.</p>
        <label for="NewPassword">New password</label>
        <input name="NewPassword" id="NewPassword" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" autofocus required />
        <label for="ConfirmPassword">New password again</label>
        <input name="ConfirmPassword" id="ConfirmPassword" type="password" autocomplete="new-password" minlength="@Model.MinPasswordLength" required />
        <button type="submit">Change password and continue</button>
    }
    else if (Model.AskForTotp)
    {
        <input type="hidden" name="MfaTicket" value="@Model.MfaTicket" />
        <label for="Totp">Authenticator code</label>
        <input name="Totp" id="Totp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" autofocus required />
        <button type="submit">Verify</button>
    }
    else
    {
        <label for="Username">Username</label>
        <input name="Username" id="Username" value="@Model.Username" autocomplete="username" autocapitalize="none" autofocus required />
        <label for="Password">Password</label>
        <input name="Password" id="Password" type="password" autocomplete="current-password" required />
        <button type="submit">Sign in</button>
    }
</form>
