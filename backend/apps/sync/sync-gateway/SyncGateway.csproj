<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\libs\Sync.Common\Sync.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one shared schema (architecture §5), copied next to the binary for validation. -->
    <None Include="..\..\..\..\contracts\wound-event.schema.json" Link="contracts\wound-event.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <!-- The RAG answer contract (§10.2), for the REST baseline (§13.1). -->
    <None Include="..\..\..\..\contracts\rag-response.schema.json" Link="contracts\rag-response.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
