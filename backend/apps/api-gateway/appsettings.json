{
  "Jwt": {
    "MetadataAddress": "http://localhost:8085/.well-known/openid-configuration",
    "RequireHttpsMetadata": false,
    "Issuer": "https://identity.melanin-wound-cdss/",
    "Audiences": [ "melanin-wound-cdss-devices", "melanin-wound-cdss-admin" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3001" ]
  },
  "RateLimits": {
    "AuthPerMinutePerIp": 120,
    "ApiPerMinutePerClient": 600
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 2097152
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-mfa": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "auth",
        "CorsPolicy": "dashboard",
        "Match": { "Path": "/v1/auth/mfa/{**rest}" }
      },
      "admin": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "dashboard",
        "Match": { "Path": "/v1/admin/{**rest}" }
      },
      "me": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "dashboard",
        "Match": { "Path": "/v1/me/{**rest}" }
      },
      "connect": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "dashboard",
        "Match": { "Path": "/connect/{**rest}" }
      },
      "account-submit": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "auth",
        "Order": -1,
        "Match": { "Path": "/account/{**rest}", "Methods": [ "POST" ] }
      },
      "account": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/account/{**rest}" }
      },
      "discovery": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "CorsPolicy": "dashboard",
        "Match": { "Path": "/.well-known/{**rest}" }
      },
      "sync": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/v1/sync/{**rest}" }
      },
      "patients": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "CorsPolicy": "dashboard",
        "Match": { "Path": "/v1/patients/{**rest}" }
      },
      "figures": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/v1/figures/{**rest}" }
      },
      "chat": {
        "ClusterId": "chat",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/v1/assessments/{assessmentId}/revisions/{revision}/chat/{**rest}" }
      },
      "baseline": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "api",
        "Match": { "Path": "/v1/baseline/{**rest}" }
      },
      "health": {
        "ClusterId": "sync",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/health" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "d1": { "Address": "http://localhost:8085/" } }
      },
      "sync": {
        "Destinations": { "d1": { "Address": "http://localhost:8086/" } }
      },
      "chat": {
        "HttpRequest": { "ActivityTimeout": "00:02:40" },
        "Destinations": { "d1": { "Address": "http://localhost:8086/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
